rigita<\u002Fspan>\n            <span style=\"font-size:13px;color:var(--color-neutral-700)\">Lithuania · 60 m²<\u002Fspan>\n            <span style=\"font-size:13px;color:var(--color-neutral-600)\">2026<\u002Fspan>\n          <\u002Fa>\n        <\u002Fdiv>\n        <\u002Fsc-if>\n\n        <sc-if value=\"{{ gridIndex }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:clamp(16px,2.4vw,30px)\">\n          <a sc-camel-on-click=\"{{ goP1 }}\" style=\"display:block;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:14px;color:var(--color-text)\" style-hover=\"background:var(--color-accent-100)\">\n            <img src=\"7fe98420-96ee-4ed8-96ae-8a48fddc0282\" alt=\"202 Modular Housing\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:0;filter:var(--img-filter)\">\n            <div style=\"display:flex;align-items:baseline;gap:10px;margin-top:14px\"><span style=\"font-family:var(--font-heading);color:var(--color-accent)\">01<\u002Fspan><span style=\"font-family:var(--font-heading);font-size:22px;line-height:1.1\">202 Modular Housing<\u002Fspan><\u002Fdiv>\n            <div style=\"font-size:13px;color:var(--color-neutral-700);margin-top:6px\">Lithuania · 65 m² · 2025<\u002Fdiv>\n          <\u002Fa>\n          <a sc-camel-on-click=\"{{ goP2 }}\" style=\"display:block;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:14px;color:var(--color-text)\" style-hover=\"background:var(--color-accent-100)\">\n            <img src=\"435665c6-a62d-4ee8-b360-ca669fd5cb81\" alt=\"202 Modular Sauna\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:0;filter:var(--img-filter)\">\n            <div style=\"display:flex;align-items:baseline;gap:10px;margin-top:14px\"><span style=\"font-family:var(--font-heading);color:var(--color-accent)\">02<\u002Fspan><span style=\"font-family:var(--font-heading);font-size:22px;line-height:1.1\">202 Modular Sauna<\u002Fspan><\u002Fdiv>\n            <div style=\"font-size:13px;color:var(--color-neutral-700);margin-top:6px\">Lithuania · 30 m² · 2025<\u002Fdiv>\n          <\u002Fa>\n          <a sc-camel-on-click=\"{{ goP3 }}\" style=\"display:block;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:14px;color:var(--color-text)\" style-hover=\"background:var(--color-accent-100)\">\n            <img src=\"45751191-88fd-46d8-8264-590fba085f06\" alt=\"209 Rokai Interior\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:0;filter:var(--img-filter)\">\n            <div style=\"display:flex;align-items:baseline;gap:10px;margin-top:14px\"><span style=\"font-family:var(--font-heading);color:var(--color-accent)\">03<\u002Fspan><span style=\"font-family:var(--font-heading);font-size:22px;line-height:1.1\">209 Rokai Interior<\u002Fspan><\u002Fdiv>\n            <div style=\"font-size:13px;color:var(--color-neutral-700);margin-top:6px\">Lithuania · 120 m² · 2025<\u002Fdiv>\n          <\u002Fa>\n          <a sc-camel-on-click=\"{{ goP4 }}\" style=\"display:block;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:14px;color:var(--color-text)\" style-hover=\"background:var(--color-accent-100)\">\n            <img src=\"09c78b78-9961-4ddd-b9e0-dd5f80637af5\" alt=\"216 Brigita\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:0;filter:var(--img-filter)\">\n            <div style=\"display:flex;align-items:baseline;gap:10px;margin-top:14px\"><span style=\"font-family:var(--font-heading);color:var(--color-accent)\">04<\u002Fspan><span style=\"font-family:var(--font-heading);font-size:22px;line-height:1.1\">216 Brigita<\u002Fspan><\u002Fdiv>\n            <div style=\"font-size:13px;color:var(--color-neutral-700);margin-top:6px\">Lithuania · 60 m² · 2026<\u002Fdiv>\n          <\u002Fa>\n        <\u002Fdiv>\n        <\u002Fsc-if>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section id=\"about\" style=\"background:var(--color-surface);padding:clamp(52px,7vw,120px) clamp(18px,5vw,72px);margin-top:clamp(40px,6vw,96px)\">\n      <div style=\"max-width:1340px;margin:0 auto\">\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:clamp(28px,5vw,72px);align-items:start\">\n          <div>\n            <h2 style=\"font-family:var(--font-heading);font-weight:700;font-size:clamp(32px,4.6vw,62px);line-height:1;margin:0;letter-spacing:-.03em;text-transform:uppercase\">About<\u002Fh2>\n            <p style=\"font-size:clamp(16px,1.4vw,19px);line-height:1.7;color:var(--color-neutral-800);max-width:58ch;margin:22px 0 0;text-wrap:pretty\">\n              I came to architecture through the workshop. Eight years designing furniture and cabinetry at Creativos en Carpintería taught me the thing drawings alone never do: how a joint is actually cut, what a millimetre costs on site, and why a plan is only as good as the hands that will build it.\n            <\u002Fp>\n            <p style=\"font-size:clamp(16px,1.4vw,19px);line-height:1.7;color:var(--color-neutral-800);max-width:58ch;margin:16px 0 0;text-wrap:pretty\">\n              For the last two years I have carried that into modular housing and interiors at OHA Design in Lithuania — buildings that are largely finished before they reach their site, where every decision has to be resolved early and honestly. Small footprints, dark timber, long light.\n            <\u002Fp>\n            <p style=\"font-size:clamp(16px,1.4vw,19px);line-height:1.7;color:var(--color-neutral-800);max-width:58ch;margin:16px 0 0;text-wrap:pretty\">\n              What I am looking for now is a Senior Architect seat where one person carries a project the whole way — concept, plans, execution — rather than handing it across a fence halfway through.\n            <\u002Fp>\n          <\u002Fdiv>\n          <div style=\"display:grid;gap:clamp(22px,3vw,36px)\">\n            <div>\n              <div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent-700);padding-bottom:10px;border-bottom:2px solid var(--color-divider)\">Experience<\u002Fdiv>\n              <div style=\"display:flex;flex-direction:column;gap:14px;margin-top:14px;font-size:15px;line-height:1.5\">\n                <div><div style=\"font-weight:600\">Senior Architect · OHA Design<\u002Fdiv><div style=\"color:var(--color-neutral-700)\">Modular homes and interior design · Lithuania · 2 years<\u002Fdiv><\u002Fdiv>\n                <div><div style=\"font-weight:600\">Designer · Creativos en Carpintería<\u002Fdiv><div style=\"color:var(--color-neutral-700)\">Furniture and cabinetry design · 8 years<\u002Fdiv><\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n            <div>\n              <div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent-700);padding-bottom:10px;border-bottom:2px solid var(--color-divider)\">Education &amp; publication<\u002Fdiv>\n              <div style=\"display:flex;flex-direction:column;gap:14px;margin-top:14px;font-size:15px;line-height:1.5\">\n                <div><div style=\"font-weight:600\">Master in Architecture · UAG<\u002Fdiv><div style=\"color:var(--color-neutral-700)\">Universidad Autónoma de Guadalajara<\u002Fdiv><\u002Fdiv>\n                <div><div style=\"font-weight:600;text-wrap:pretty\">“Segregación y fragmentación socioespacial en ciudades. Nuevas formas de habitar la ciudad”<\u002Fdiv><div style=\"color:var(--color-neutral-700)\">Master's thesis, published by UAG<\u002Fdiv><\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n            <div>\n              <div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent-700);padding-bottom:10px;border-bottom:2px solid var(--color-divider)\">Skills<\u002Fdiv>\n              <div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:14px\">\n                <span class=\"tag tag-neutral\">Modular housing design<\u002Fspan>\n                <span class=\"tag tag-neutral\">Interior design<\u002Fspan>\n                <span class=\"tag tag-neutral\">Furniture &amp; cabinetry<\u002Fspan>\n                <span class=\"tag tag-neutral\">Construction documentation<\u002Fspan>\n                <span class=\"tag tag-neutral\">Visualisation<\u002Fspan>\n                <span class=\"tag tag-neutral\">Site execution<\u002Fspan>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section id=\"contact\" style=\"padding:clamp(56px,8vw,130px) clamp(18px,5vw,72px)\">\n      <div style=\"max-width:1340px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:clamp(28px,5vw,72px);align-items:end\">\n        <div>\n          <h2 style=\"font-family:var(--font-heading);font-weight:700;font-size:clamp(38px,7vw,100px);line-height:.9;margin:0;letter-spacing:-.045em;text-transform:uppercase\">Concept to<br>execution<span style=\"color:var(--color-accent)\">.<\u002Fspan><\u002Fh2>\n          <p style=\"font-size:17px;line-height:1.65;color:var(--color-neutral-800);max-width:44ch;margin:22px 0 0\">Open to Senior Architect roles and to private clients who want one architect from first sketch to final handover.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"display:flex;flex-direction:column;gap:16px;align-items:flex-start\">\n          <a href=\"mailto:osmanmota932@gmail.com\" style=\"font-family:var(--font-heading);font-size:clamp(20px,2.4vw,32px);line-height:1.15;word-break:break-word\">osmanmota932@gmail.com<\u002Fa>\n          <div style=\"font-size:16px;line-height:1.7;color:var(--color-neutral-800)\">Guadalajara, Mexico<br>Working with OHA Design, Lithuania<\u002Fdiv>\n          <div style=\"display:flex;flex-wrap:wrap;gap:10px;margin-top:4px\">\n            <a class=\"btn btn-secondary\" href=\"https://www.instagram.com/sketch_studio_mx/\" target=\"_blank\" rel=\"noopener\">Instagram<\u002Fa>\n            <a class=\"btn btn-primary\" sc-camel-on-click=\"{{ goWork }}\">See the work<\u002Fa>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"max-width:1340px;margin:clamp(44px,6vw,92px) auto 0;padding-top:20px;border-top:2px solid var(--color-divider);display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--color-neutral-600)\">\n        <span>© 2026 Osman Mota<\u002Fspan>\n        <span>M. Architect · Guadalajara<\u002Fspan>\n      <\u002Fdiv>\n    <\u002Fsection>\n  <\u002Fmain>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ atP1 }}\" hint-placeholder-val=\"{{ false }}\">\n  <main style=\"padding:clamp(28px,4vw,56px) clamp(18px,5vw,72px) clamp(56px,8vw,120px)\">\n    <div style=\"max-width:1340px;margin:0 auto\">\n      <a sc-camel-on-click=\"{{ goWork }}\" style=\"font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--color-neutral-700)\">← All work<\u002Fa>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(24px,4vw,64px);align-items:start;margin-top:clamp(18px,3vw,36px)\">\n        <div>\n          <span style=\"font-family:var(--font-heading);font-size:clamp(70px,11vw,164px);line-height:.78;color:var(--color-accent);display:block\">01<\u002Fspan>\n          <h1 style=\"font-family:var(--font-heading);font-weight:700;font-size:clamp(32px,4.8vw,64px);line-height:1;margin:14px 0 0;letter-spacing:-.035em;text-transform:uppercase\">202 Modular Housing<\u002Fh1>\n          <p style=\"font-size:17px;line-height:1.68;color:var(--color-neutral-800);max-width:52ch;margin:22px 0 0;text-wrap:pretty\">\n            A 65 m² house built as modules in a factory and set down in a Lithuanian pine forest, finished, in a single day. Blackened timber outside so the volume recedes between the trunks; pale oak and lime plaster inside so the short northern light goes as far as it can.\n          <\u002Fp>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));background:var(--color-bg);border:2px solid var(--color-divider);border-radius:var(--radius-md);overflow:hidden\">\n          <div style=\"padding:18px 20px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Client<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">OHA Design<\u002Fdiv><\u002Fdiv>\n          <div style=\"padding:18px 20px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Location<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">Lithuania<\u002Fdiv><\u002Fdiv>\n          <div style=\"padding:18px 20px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Area<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">65 m²<\u002Fdiv><\u002Fdiv>\n          <div style=\"padding:18px 20px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Year<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">2025<\u002Fdiv><\u002Fdiv>\n          <div style=\"padding:18px 20px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Role<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">Senior Architect<\u002Fdiv><\u002Fdiv>\n          <div style=\"padding:18px 20px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Scope<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">Concept → execution<\u002Fdiv><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <figure style=\"margin:clamp(26px,4vw,52px) 0 0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-lg);padding:clamp(12px,1.4vw,18px)\">\n        <img src=\"7fe98420-96ee-4ed8-96ae-8a48fddc0282\" alt=\"Approach to the modular house through the pines\" style=\"display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:var(--radius-md);filter:var(--img-filter)\">\n        <sc-if value=\"{{ showCaptions }}\" hint-placeholder-val=\"{{ true }}\"><figcaption style=\"font-size:12px;letter-spacing:.06em;color:var(--color-neutral-700);padding:12px 4px 2px\">The approach — the gravel track is the only ground the project disturbs.<\u002Ffigcaption><\u002Fsc-if>\n      <\u002Ffigure>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:clamp(14px,2vw,26px);margin-top:clamp(14px,2vw,26px)\">\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\">\n          <img src=\"0802b52b-1e7e-416b-8373-bcac9c95fe87\" alt=\"The house in its clearing\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:0;filter:var(--img-filter)\">\n          <sc-if value=\"{{ showCaptions }}\" hint-placeholder-val=\"{{ true }}\"><figcaption style=\"font-size:12px;color:var(--color-neutral-700);padding:10px 2px 0\">Sited in the clearing, not on it.<\u002Ffigcaption><\u002Fsc-if>\n        <\u002Ffigure>\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\">\n          <img src=\"203dd7ed-1372-406f-8434-da3b046f60a1\" alt=\"Kitchen and dining under exposed beams\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:0;filter:var(--img-filter)\">\n          <sc-if value=\"{{ showCaptions }}\" hint-placeholder-val=\"{{ true }}\"><figcaption style=\"font-size:12px;color:var(--color-neutral-700);padding:10px 2px 0\">Kitchen and table share one beam rhythm.<\u002Ffigcaption><\u002Fsc-if>\n        <\u002Ffigure>\n      <\u002Fdiv>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:clamp(24px,4vw,56px);margin-top:clamp(34px,5vw,68px);align-items:start\">\n        <div>\n          <div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent-700)\">Concept<\u002Fdiv>\n          <p style=\"font-size:16px;line-height:1.7;color:var(--color-neutral-800);margin:12px 0 0;text-wrap:pretty\">Sixty-five square metres leaves no room for a corridor, so there isn't one. The plan is a single spine of cabinetry — my old trade — that carries storage, kitchen, wardrobe and the bathroom wall, and everything else opens off it.<\u002Fp>\n        <\u002Fdiv>\n        <div>\n          <div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent-700)\">Execution<\u002Fdiv>\n          <p style=\"font-size:16px;line-height:1.7;color:var(--color-neutral-800);margin:12px 0 0;text-wrap:pretty\">Because the modules ship complete, every junction had to be resolved on paper months before anyone lifted a tool. I drew the plans, the cabinetry and the site details, and stayed with the build through delivery.<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:clamp(14px,2vw,26px);margin-top:clamp(24px,4vw,48px)\">\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"f46a074a-966a-4f05-b701-9754ce2a8875\" alt=\"Dining area toward the garden window\" style=\"display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"c6ad4f3a-cd62-437e-a3a1-4707e81fd22d\" alt=\"Bedroom with fluted headboard wall\" style=\"display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"890237ce-2455-40ec-a718-ea1543db508d\" alt=\"Second bedroom\" style=\"display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"e7f84407-b8f0-46a9-accf-281f5f8582dc\" alt=\"Living room\" style=\"display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n      <\u002Fdiv>\n\n      <a sc-camel-on-click=\"{{ goP2 }}\" style=\"display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:14px;margin-top:clamp(40px,6vw,88px);padding-top:22px;border-top:2px solid var(--color-divider);color:var(--color-text)\" style-hover=\"color:var(--color-accent-700)\">\n        <span style=\"font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--color-neutral-600)\">Next project<\u002Fspan>\n        <span style=\"font-family:var(--font-heading);font-size:clamp(24px,3.4vw,46px);line-height:1\">02 · 202 Modular Sauna →<\u002Fspan>\n      <\u002Fa>\n    <\u002Fdiv>\n  <\u002Fmain>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ atP2 }}\" hint-placeholder-val=\"{{ false }}\">\n  <main>\n    <section style=\"background:var(--color-accent);color:#ffffff;padding:clamp(28px,4vw,52px) clamp(18px,5vw,72px) clamp(52px,7vw,110px)\">\n      <div style=\"max-width:1340px;margin:0 auto\">\n        <a sc-camel-on-click=\"{{ goWork }}\" style=\"font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#ffffff\">← All work<\u002Fa>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(28px,5vw,72px);align-items:center;margin-top:clamp(20px,3vw,40px)\">\n          <div>\n            <span style=\"font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:color-mix(in srgb, #ffffff 80%, transparent)\">OHA Design · Lithuania · 2025<\u002Fspan>\n            <h1 style=\"font-family:var(--font-heading);font-weight:700;font-size:clamp(38px,6vw,84px);line-height:.98;margin:14px 0 0;letter-spacing:-.035em;text-transform:uppercase;color:#ffffff\">202 Modular Sauna<\u002Fh1>\n            <p style=\"font-size:17px;line-height:1.68;color:#ffffff;max-width:50ch;margin:22px 0 0;text-wrap:pretty\">\n              Thirty square metres at the edge of the water: a black box that gives nothing away outside and is entirely cedar within. One long window frames the pond from the bench, and the fire does the rest.\n            <\u002Fp>\n            <div style=\"display:flex;flex-wrap:wrap;gap:26px;margin-top:32px\">\n              <div><div style=\"font-family:var(--font-heading);font-size:32px;line-height:1;color:#ffffff\">30 m²<\u002Fdiv><div style=\"font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:color-mix(in srgb, #ffffff 80%, transparent);margin-top:8px\">Footprint<\u002Fdiv><\u002Fdiv>\n              <div><div style=\"font-family:var(--font-heading);font-size:32px;line-height:1;color:#ffffff\">1 day<\u002Fdiv><div style=\"font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:color-mix(in srgb, #ffffff 80%, transparent);margin-top:8px\">On-site install<\u002Fdiv><\u002Fdiv>\n              <div><div style=\"font-family:var(--font-heading);font-size:32px;line-height:1;color:#ffffff\">Sr.<\u002Fdiv><div style=\"font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:color-mix(in srgb, #ffffff 80%, transparent);margin-top:8px\">Architect, full scope<\u002Fdiv><\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n          <div>\n            <span style=\"display:block;font-family:var(--font-heading);font-weight:700;font-size:clamp(64px,9vw,148px);line-height:.8;letter-spacing:-.045em;color:#ffffff;margin-bottom:16px\">02<\u002Fspan>\n            <img src=\"435665c6-a62d-4ee8-b360-ca669fd5cb81\" alt=\"The sauna at the water's edge among pines\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;filter:var(--img-filter);border-radius:var(--radius-lg)\">\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:clamp(14px,2vw,26px);margin-top:clamp(24px,4vw,48px)\">\n          <figure style=\"margin:0\"><img src=\"9dda6629-6979-4d10-a07c-67e11edce429\" alt=\"The sauna volume seen from the slope\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;filter:var(--img-filter);border-radius:var(--radius-md)\"><sc-if value=\"{{ showCaptions }}\" hint-placeholder-val=\"{{ true }}\"><figcaption style=\"font-size:12px;color:color-mix(in srgb, #ffffff 80%, transparent);padding:10px 2px 0\">Dark cladding, so the trees stay the subject.<\u002Ffigcaption><\u002Fsc-if><\u002Ffigure>\n          <figure style=\"margin:0\"><img src=\"d2785a7d-2604-44fe-bfe5-b84b68889de8\" alt=\"Cedar-lined sauna interior with bench and window\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;filter:var(--img-filter);border-radius:var(--radius-md)\"><sc-if value=\"{{ showCaptions }}\" hint-placeholder-val=\"{{ true }}\"><figcaption style=\"font-size:12px;color:color-mix(in srgb, #ffffff 80%, transparent);padding:10px 2px 0\">Inside: cedar, one bench, one view.<\u002Ffigcaption><\u002Fsc-if><\u002Ffigure>\n          <div style=\"align-self:center\">\n            <div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:color-mix(in srgb, #ffffff 80%, transparent)\">Detail<\u002Fdiv>\n            <p style=\"font-size:15px;line-height:1.7;color:#ffffff;margin:12px 0 0;text-wrap:pretty\">The bench, backrest and step are one continuous piece of joinery, cut from a single specification — cabinetry logic applied to a building small enough to deserve it.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <a sc-camel-on-click=\"{{ goP3 }}\" style=\"display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:14px;margin-top:clamp(40px,6vw,80px);padding-top:22px;border-top:2px solid color-mix(in srgb, #ffffff 40%, transparent);color:#ffffff\">\n          <span style=\"font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:color-mix(in srgb, #ffffff 80%, transparent)\">Next project<\u002Fspan>\n          <span style=\"font-family:var(--font-heading);font-size:clamp(24px,3.4vw,46px);line-height:1\">03 · 209 Rokai Interior →<\u002Fspan>\n        <\u002Fa>\n      <\u002Fdiv>\n    <\u002Fsection>\n  <\u002Fmain>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ atP3 }}\" hint-placeholder-val=\"{{ false }}\">\n  <main style=\"padding:clamp(28px,4vw,56px) clamp(18px,5vw,72px) clamp(56px,8vw,120px)\">\n    <div style=\"max-width:1340px;margin:0 auto\">\n      <a sc-camel-on-click=\"{{ goWork }}\" style=\"font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--color-neutral-700)\">← All work<\u002Fa>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(24px,4vw,64px);align-items:start;margin-top:clamp(18px,3vw,36px)\">\n        <div>\n          <div style=\"display:flex;align-items:flex-start;gap:18px\">\n            <span style=\"font-family:var(--font-heading);font-size:clamp(58px,9vw,132px);line-height:.78;color:var(--color-accent)\">03<\u002Fspan>\n            <h1 style=\"font-family:var(--font-heading);font-weight:700;font-size:clamp(28px,4.2vw,56px);line-height:1;margin:6px 0 0;letter-spacing:-.035em;text-transform:uppercase\">209 Rokai Interior<\u002Fh1>\n          <\u002Fdiv>\n          <p style=\"font-size:17px;line-height:1.68;color:var(--color-neutral-800);max-width:52ch;margin:22px 0 0;text-wrap:pretty\">\n            A 120 m² apartment rebuilt around dark stained oak. The brief asked for calm, so the work went into removing things: no handles, no visible frames, no skirting — the joinery runs floor to ceiling and the doors disappear into it.\n          <\u002Fp>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));background:var(--color-bg);border:2px solid var(--color-divider);border-radius:var(--radius-md);overflow:hidden\">\n          <div style=\"padding:18px 20px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Client<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">OHA Design<\u002Fdiv><\u002Fdiv>\n          <div style=\"padding:18px 20px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Location<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">Rokai, Lithuania<\u002Fdiv><\u002Fdiv>\n          <div style=\"padding:18px 20px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Area<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">120 m²<\u002Fdiv><\u002Fdiv>\n          <div style=\"padding:18px 20px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Year<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">2025<\u002Fdiv><\u002Fdiv>\n          <div style=\"padding:18px 20px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Role<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">Senior Architect<\u002Fdiv><\u002Fdiv>\n          <div style=\"padding:18px 20px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Scope<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">Interior + cabinetry<\u002Fdiv><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <figure style=\"margin:clamp(26px,4vw,52px) 0 0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-lg);padding:clamp(12px,1.4vw,18px)\">\n        <img src=\"45751191-88fd-46d8-8264-590fba085f06\" alt=\"Kitchen with curved island in stained oak\" style=\"display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:var(--radius-md);filter:var(--img-filter)\">\n        <sc-if value=\"{{ showCaptions }}\" hint-placeholder-val=\"{{ true }}\"><figcaption style=\"font-size:12px;letter-spacing:.06em;color:var(--color-neutral-700);padding:12px 4px 2px\">The curved island is the only soft edge in the apartment, and it is the one everyone touches.<\u002Ffigcaption><\u002Fsc-if>\n      <\u002Ffigure>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:clamp(14px,2vw,26px);margin-top:clamp(14px,2vw,26px)\">\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"4f667de8-2b39-4450-ba73-0fb88fde99bc\" alt=\"Bedroom with wardrobe and desk\" style=\"display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"6bfcba93-337f-44c2-8172-389b9ff796d3\" alt=\"Marble bathroom\" style=\"display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"bec8f568-a4d7-41eb-940f-82f6f43bebe1\" alt=\"Corridor lined in full-height joinery\" style=\"display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"3c1d61db-c197-4d99-8b55-15b8cad0092f\" alt=\"Entry storage wall\" style=\"display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n      <\u002Fdiv>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:clamp(24px,4vw,56px);margin-top:clamp(34px,5vw,68px);align-items:start\">\n        <div>\n          <div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent-700)\">Approach<\u002Fdiv>\n          <p style=\"font-size:16px;line-height:1.7;color:var(--color-neutral-800);margin:12px 0 0;text-wrap:pretty\">Every wall was measured as a cabinetry elevation before it was drawn as a plan. That reversal — furniture first, partitions second — is what let the storage vanish into the architecture instead of being bought later.<\u002Fp>\n        <\u002Fdiv>\n        <div>\n          <div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent-700)\">Material<\u002Fdiv>\n          <p style=\"font-size:16px;line-height:1.7;color:var(--color-neutral-800);margin:12px 0 0;text-wrap:pretty\">Stained oak, honed marble, brushed bronze, plaster. Four materials repeated in every room so a 120 m² plan reads as one space rather than seven.<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:clamp(14px,2vw,26px);margin-top:clamp(24px,4vw,48px)\">\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"a5828334-bb41-4624-ae7e-da3f0763de10\" alt=\"Living room with plate wall\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"091aedd5-c46b-4a23-984e-792a64a3fbff\" alt=\"Main bedroom\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"59e49462-7ad0-425f-a9c5-2eb5f3668f3f\" alt=\"Guest bath\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n      <\u002Fdiv>\n\n      <a sc-camel-on-click=\"{{ goP4 }}\" style=\"display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:14px;margin-top:clamp(40px,6vw,88px);padding-top:22px;border-top:2px solid var(--color-divider);color:var(--color-text)\" style-hover=\"color:var(--color-accent-700)\">\n        <span style=\"font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--color-neutral-600)\">Next project<\u002Fspan>\n        <span style=\"font-family:var(--font-heading);font-size:clamp(24px,3.4vw,46px);line-height:1\">04 · 216 Brigita →<\u002Fspan>\n      <\u002Fa>\n    <\u002Fdiv>\n  <\u002Fmain>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ atP4 }}\" hint-placeholder-val=\"{{ false }}\">\n  <main style=\"padding:clamp(28px,4vw,56px) clamp(18px,5vw,72px) clamp(56px,8vw,120px)\">\n    <div style=\"max-width:1340px;margin:0 auto\">\n      <a sc-camel-on-click=\"{{ goWork }}\" style=\"font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--color-neutral-700)\">← All work<\u002Fa>\n      <div style=\"display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px;margin-top:clamp(18px,3vw,36px);padding-bottom:clamp(18px,2.6vw,32px);border-bottom:2px solid var(--color-divider)\">\n        <div>\n          <span style=\"font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--color-neutral-600)\">OHA Design · Lithuania · 2026<\u002Fspan>\n          <h1 style=\"font-family:var(--font-heading);font-weight:700;font-size:clamp(32px,5vw,68px);line-height:1;margin:12px 0 0;letter-spacing:-.035em;text-transform:uppercase\">216 Brigita<\u002Fh1>\n        <\u002Fdiv>\n        <span style=\"font-family:var(--font-heading);font-size:clamp(58px,9vw,132px);line-height:.78;color:var(--color-accent)\">04<\u002Fspan>\n      <\u002Fdiv>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:clamp(24px,4vw,60px);margin-top:clamp(24px,4vw,48px);align-items:start\">\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-lg);padding:clamp(12px,1.4vw,18px)\">\n          <img src=\"09c78b78-9961-4ddd-b9e0-dd5f80637af5\" alt=\"Living room of the Brigita apartment opening to the garden\" style=\"display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius-md);filter:var(--img-filter)\">\n          <sc-if value=\"{{ showCaptions }}\" hint-placeholder-val=\"{{ true }}\"><figcaption style=\"font-size:12px;letter-spacing:.06em;color:var(--color-neutral-700);padding:12px 4px 2px\">One room, three uses — the window wall sets the whole plan.<\u002Ffigcaption><\u002Fsc-if>\n        <\u002Ffigure>\n        <div>\n          <p style=\"font-size:17px;line-height:1.68;color:var(--color-neutral-800);max-width:52ch;margin:0;text-wrap:pretty\">\n            Sixty square metres kept deliberately pale. Living, dining and kitchen share a single volume under one plastered ceiling plane, and the storage runs the length of the flank wall so the floor stays clear from the door to the garden.\n          <\u002Fp>\n          <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));background:var(--color-bg);border:2px solid var(--color-divider);border-radius:var(--radius-md);overflow:hidden;margin-top:28px\">\n            <div style=\"padding:16px 18px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Area<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">60 m²<\u002Fdiv><\u002Fdiv>\n            <div style=\"padding:16px 18px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Client<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">OHA Design<\u002Fdiv><\u002Fdiv>\n            <div style=\"padding:16px 18px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Role<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">Senior Architect<\u002Fdiv><\u002Fdiv>\n            <div style=\"padding:16px 18px;box-shadow:0 0 0 1px var(--color-divider)\"><div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-neutral-600)\">Year<\u002Fdiv><div style=\"font-size:15px;margin-top:6px\">2026<\u002Fdiv><\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent-700);margin-top:30px\">Light<\u002Fdiv>\n          <p style=\"font-size:16px;line-height:1.7;color:var(--color-neutral-800);margin:12px 0 0;text-wrap:pretty\">A continuous cove around the ceiling perimeter does the evening work, so no fitting is ever seen and the plaster reads as one surface from morning to night.<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:clamp(14px,2vw,26px);margin-top:clamp(14px,2vw,26px)\">\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"be3e7bec-6b02-4134-ad03-122dd1d83366\" alt=\"Kitchen and dining under the cove-lit ceiling\" style=\"display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"ba19ba7c-ebf1-411a-86d0-990299d8ac86\" alt=\"Living wall with recessed shelving and media niche\" style=\"display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"25a5c77b-59c4-4e29-8b5b-504a3157c9d0\" alt=\"Bedroom with oak wardrobe wall\" style=\"display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n        <figure style=\"margin:0;background:var(--color-neutral-100);border:2px solid var(--color-divider);border-radius:var(--radius-md);padding:12px\"><img src=\"d89ecbff-9b5d-4b2b-b8b9-33ff7e30e486\" alt=\"Bathroom with stone basin\" style=\"display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:0;filter:var(--img-filter)\"><\u002Ffigure>\n      <\u002Fdiv>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:clamp(24px,4vw,56px);margin-top:clamp(34px,5vw,68px);align-items:start\">\n        <div>\n          <div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent-700)\">Plan<\u002Fdiv>\n          <p style=\"font-size:16px;line-height:1.7;color:var(--color-neutral-800);margin:12px 0 0;text-wrap:pretty\">The kitchen was pushed to the darkest end of the volume and the seating to the light, so a small flat still gives you two different places to sit at different hours of the day.<\u002Fp>\n        <\u002Fdiv>\n        <div>\n          <div style=\"font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent-700)\">Material<\u002Fdiv>\n          <p style=\"font-size:16px;line-height:1.7;color:var(--color-neutral-800);margin:12px 0 0;text-wrap:pretty\">Pale oak, lime plaster, bone-white lacquer and one dark stone in the bathroom — the single moment of weight in an otherwise weightless apartment.<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <a sc-camel-on-click=\"{{ goP1 }}\" style=\"display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:14px;margin-top:clamp(40px,6vw,88px);padding-top:22px;border-top:2px solid var(--color-divider);color:var(--color-text)\" style-hover=\"color:var(--color-accent-700)\">\n        <span style=\"font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--color-neutral-600)\">Back to the start<\u002Fspan>\n        <span style=\"font-family:var(--font-heading);font-size:clamp(24px,3.4vw,46px);line-height:1\">01 · 202 Modular Housing →<\u002Fspan>\n      <\u002Fa>\n    <\u002Fdiv>\n  <\u002Fmain>\n  <\u002Fsc-if>\n\n<\u002Fdiv>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;indexStyle&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;list&quot;,&quot;grid&quot;],&quot;default&quot;:&quot;list&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Layout&quot;},&quot;showCaptions&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Layout&quot;},&quot;imageWash&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;graded&quot;,&quot;bw&quot;,&quot;none&quot;],&quot;default&quot;:&quot;graded&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Imagery&quot;}}\">\nclass Component extends DCLogic {\n  state = { page: \"index\", anchor: null };\n\n  go(page, anchor) {\n    this.setState({ page, anchor: anchor || null }, () => {\n      if (!anchor) { window.scrollTo(0, 0); return; }\n      const el = document.getElementById(anchor);\n      if (!el) { window.scrollTo(0, 0); return; }\n      window.scrollTo({ top: el.getBoundingClientRect().top + window.pageYOffset - 64, behavior: \"smooth\" });\n    });\n  }\n\n  renderVals() {\n    const p = this.state.page;\n    const index = this.props.indexStyle ?? \"list\";\n    const wash = this.props.imageWash ?? \"graded\";\n    return {\n      themeVars: { \"--img-filter\": wash === \"none\" ? \"none\" : wash === \"bw\" ? \"grayscale(1) contrast(1.08)\" : \"saturate(.78) contrast(1.04) sepia(.22) brightness(1.03)\" },\n      showCaptions: this.props.showCaptions ?? true,\n      listIndex: index === \"list\",\n      gridIndex: index === \"grid\",\n      atIndex: p === \"index\", atP1: p === \"p1\", atP2: p === \"p2\", atP3: p === \"p3\", atP4: p === \"p4\",\n      goIndex: () => this.go(\"index\"),\n      goWork: () => this.go(\"index\", \"work\"),\n      goAbout: () => this.go(\"index\", \"about\"),\n      goContact: () => this.go(\"index\", \"contact\"),\n      goP1: () => this.go(\"p1\"), goP2: () => this.go(\"p2\"), goP3: () => this.go(\"p3\"), goP4: () => this.go(\"p4\")\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
